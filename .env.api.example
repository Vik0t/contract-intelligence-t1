APP_ENV=production
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
# Select this file for Compose service env_file as well as variable interpolation.
SERVER_ENV_FILE=.env.api
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080
ML_ALLOW_EXTERNAL=true
ML_HF_FALLBACK_ENABLED=false
HF_EXTRACTION_FALLBACK_ENABLED=false
ML_API_TIMEOUT=120
DEEPCODE_ENABLE_THINKING=false
EXTRACTION_BACKEND=api
EXTRACTION_API_PROVIDER=deepcode
# This alias must match the ID exposed by your DeepCode /models endpoint.
EXTRACTION_API_MODEL=qwen3.8-flash-next
EXTRACTION_API_MAX_NEW_TOKENS=4096
EXTRACTION_CHUNK_CHARS=12000
SUMMARY_BACKEND=api
SUMMARY_PROVIDER=deepcode
SUMMARY_MODEL_NAME=qwen3.8-flash-next
SUMMARY_MAX_INPUT_CHARS=12000
SUMMARY_MAX_NEW_TOKENS=800
RISK_BACKEND=api
RISK_PROVIDER=deepcode
RISK_MODEL_NAME=qwen3.8-flash-next
RISK_MAX_INPUT_CHARS=12000
RISK_MAX_NEW_TOKENS=2000
OPENAI_BASE_URL=
OPENAI_API_KEY=
DOCX_USE_RENDERED_PAGES=true
