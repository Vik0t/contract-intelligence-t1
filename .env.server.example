APP_ENV=production
# Use an ASCII hex password: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_JOB_ATTEMPTS=3
JOB_WORKER_COUNT=1
ML_ALLOW_EXTERNAL=false
ML_HF_FALLBACK_ENABLED=false
HF_EXTRACTION_FALLBACK_ENABLED=false
ML_KEEP_MODELS_LOADED=false
EXTRACTION_BACKEND=local
CONTRACT_EXTRACTION_BACKEND=huggingface
CONTRACT_MODEL_ID=numind/NuExtract3
# Explicit revisions; update together with the model and re-run ml-check.
CONTRACT_MODEL_REVISION=c99dc8f5641b866aa0192b6ea78f84bf9f3535f1
CONTRACT_MODEL_QUANTIZATION=bf16
EXTRACTION_CHUNK_CHARS=12000
SUMMARY_BACKEND=local
SUMMARY_LOCAL_MODEL_NAME=Qwen/Qwen3-8B
SUMMARY_LOCAL_MODEL_REVISION=b968826d9c46dd6066d109eabc6255188de91218
SUMMARY_MAX_INPUT_CHARS=12000
SUMMARY_MAX_NEW_TOKENS=800
RISK_BACKEND=local
RISK_MAX_INPUT_CHARS=12000
RISK_MAX_NEW_TOKENS=2000
DOCX_USE_RENDERED_PAGES=true
HF_TOKEN=
