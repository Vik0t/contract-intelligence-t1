# syntax=docker/dockerfile:1
# Native Linux images for both amd64 and arm64; no GPU or model downloads.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 HOME=/home/contract
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libreoffice-writer tesseract-ocr tesseract-ocr-rus tesseract-ocr-eng \
    fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY deploy/requirements-portable.lock /app/deploy/requirements-portable.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r deploy/requirements-portable.lock && pip check
RUN useradd --create-home --uid 10001 contract \
    && mkdir -p /data/uploads && chown -R contract:contract /home/contract /data
COPY --chown=contract:contract backend /app/backend
COPY --chown=contract:contract src /app/src
COPY --chown=contract:contract scripts /app/scripts
USER contract
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4)"
CMD ["python", "-m", "scripts.serve"]
