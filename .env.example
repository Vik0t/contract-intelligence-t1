APP_ENV=development
DATABASE_URL=sqlite:///documents.db
DOCUMENT_STORAGE_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=200
MAX_JOB_ATTEMPTS=3
JOB_WORKER_COUNT=1
JOB_STALE_AFTER_MINUTES=30

# CUDA model runtime: bf16 is the default; use 8bit only as a compatibility fallback.
CONTRACT_MODEL_QUANTIZATION=bf16

# Extraction backend: local is the safe default. The hosted option sends text
# and the extraction template to a public Hugging Face Space.
EXTRACTION_BACKEND=huggingface-space
HF_SPACE_ID=numind/NuExtract3
HF_SPACE_API_NAME=/on_extract_click
HF_SPACE_PROMPT_MODE=compact            # production for full instruction to the model
HF_SPACE_CONTEXT_MODE=retrieved         # full for full text of the document
HF_SPACE_CONTEXT_CHARS=3000
HF_SPACE_REASONING=false

HF_TOKEN=#свой токен

SUMMARY_BACKEND=api              # local for local usage
SUMMARY_MODEL_NAME=Qwen/Qwen3-8B:featherless-ai
SUMMARY_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct
# Summary limits
SUMMARY_MAX_INPUT_CHARS=4000
SUMMARY_MAX_NEW_TOKENS=300

# Legacy only. The current local pipeline does not require OpenRouter.
OPENROUTER_API_KEY=