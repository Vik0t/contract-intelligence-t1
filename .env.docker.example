APP_ENV=production
# Generate once: openssl rand -hex 24; keep this password with the database volume.
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
DOCKER_ENV_FILE=.env.docker
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Works immediately without GPU, weights or API keys (four PMI attributes).
DELIVERY_PROFILE=pmi-rules-v1
EXTRACTION_BACKEND=rules
ML_ALLOW_EXTERNAL=false
SUMMARY_BACKEND=local
RISK_BACKEND=local
AUTO_EXTRACT_UPLOADS=true
ALLOW_OCR_UPLOADS=false
DOCX_USE_RENDERED_PAGES=false
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=200
JOB_WORKER_COUNT=1

# To use full extraction, summaries and risks via an approved API, set:
# DELIVERY_PROFILE=custom
# EXTRACTION_BACKEND=api
# SUMMARY_BACKEND=api
# RISK_BACKEND=api
# ML_ALLOW_EXTERNAL=true
# DOCX_USE_RENDERED_PAGES=true
# ALLOW_OCR_UPLOADS=true
EXTRACTION_API_PROVIDER=deepcode
SUMMARY_PROVIDER=deepcode
RISK_PROVIDER=deepcode
OPENAI_BASE_URL=
OPENAI_API_KEY=
EXTRACTION_API_MODEL=qwen3.8-flash-next
SUMMARY_MODEL_NAME=qwen3.8-flash-next
RISK_MODEL_NAME=qwen3.8-flash-next
ML_HF_FALLBACK_ENABLED=false
HF_EXTRACTION_FALLBACK_ENABLED=false
ML_API_TRUST_ENV=false
ML_API_CONNECT_RETRIES=2
ML_API_TIMEOUT=120
DEEPCODE_ENABLE_THINKING=false
